{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "no-inline-comments": "error",
    "no-warning-comments": [
      "error",
      {
        "terms": [
          "todo",
          "fixme",
          "xxx"
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/features/**",
        "src/components/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/lib/ws",
                  "@/lib/ws/*"
                ],
                "message": "Use the Transport interface instead of the WebSocket client."
              }
            ]
          }
        ],
        "no-restricted-globals": [
          "error",
          {
            "name": "fetch",
            "message": "Use the Transport interface instead of calling fetch."
          },
          {
            "name": "WebSocket",
            "message": "Use the Transport interface instead of opening WebSockets."
          }
        ]
      }
    },
    {
      "files": [
        "src/components/ui/**"
      ],
      "rules": {
        "react/only-export-components": "off"
      }
    },
    {
      "files": [
        "e2e/**"
      ],
      "rules": {
        "react/rules-of-hooks": "off"
      }
    },
    {
      "files": [
        "src/features/explorer/EntryTable.tsx",
        "src/features/preview/viewers/HexViewer.tsx",
        "src/features/preview/viewers/CsvViewer.tsx",
        "src/features/preview/viewers/ArchiveViewer.tsx"
      ],
      "rules": {
        "react/incompatible-library": "off"
      }
    }
  ]
}
