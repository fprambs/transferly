#!/bin/sh
# Rejects commit subjects that are not Conventional Commits.
set -eu

subject=$(head -n 1 "$1")
pattern='^(feat|fix|docs|build|ci|test|refactor|perf|chore|revert)(\([a-z0-9-]+\))?!?: .{1,72}$'
if ! printf '%s\n' "$subject" | grep -Eq "$pattern"; then
  echo "Commit subject must follow Conventional Commits, for example: feat(backend): add site store" >&2
  exit 1
fi
