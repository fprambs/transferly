#!/bin/sh
# Git connects to GitHub before this hook runs. A ~15 minute test suite lets the SSH
# session go idle and GitHub closes it, so the push never completes. Use ./scripts/push.sh.
set -eu

if [ "${TRANSFERLY_PUSH_TESTS_DONE:-}" = 1 ]; then
  exit 0
fi

cat >&2 <<'EOF'
pre-push: no se ejecutan aquí los tests con cobertura (GitHub cierra SSH si tardan ~10+ min).

  ./scripts/push.sh -u origin main

Si ya corriste la misma revisión en Docker (coverage-go + pnpm test:coverage):

  TRANSFERLY_PUSH_TESTS_DONE=1 git push …
EOF
exit 1
